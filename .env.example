# Публичный адрес сайта (canonical, sitemap, Open Graph). Без слеша в конце.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true — разрешить индексацию (только на боевом домене). Иначе robots.txt закрывает сайт.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Счётчики аналитики. Пусто — счётчик не подключается.
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=

# Коды подтверждения прав в Яндекс.Вебмастере и Google Search Console
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Java-бэкенд aleks-rove-back (CMS + приём заявок). Пусто — контент из src/content, заявки пишутся в лог.
BACKEND_API_URL=
# Ключ для пересылки заявок = LEADS_API_KEY бэкенда
BACKEND_API_KEY=
# Секрет для /api/revalidate = FRONTEND_REVALIDATE_SECRET бэкенда
REVALIDATE_SECRET=
